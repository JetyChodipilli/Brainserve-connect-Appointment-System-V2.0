# BRAINSERVE LOCAL BACKEND ENVIRONMENT
# File location after copying: backend/.env
# DO NOT COMMIT backend/.env.
# Replace every CHANGE_ME value before startup.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/brainserve
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=localhost
# The container still listens on 6379 internally. Using 6380 on the host avoids
# collisions with an existing local Redis service. Keep both values aligned
# when the Spring Boot application runs from IntelliJ instead of Compose.
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_TIMEOUT=2s

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_CONSUMER_GROUP=brainserve.internal-calls.v1
INTERNAL_CALL_TOPIC=brainserve.internal-calls.v1
INTERNAL_CALL_TOPIC_PARTITIONS=3
INTERNAL_CALL_TOPIC_REPLICAS=3
INTERNAL_CALL_TOPIC_MIN_INSYNC_REPLICAS=2

# Local Mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@brainserve.in

# Browser/frontend connection
FRONTEND_PUBLIC_URL=http://localhost:5173
BRAIN_SERVE_ALLOWED_ORIGINS=http://localhost:5173
# Forwarded headers are accepted only from these physical proxy peers.
# Leave empty for direct connections; never trust the entire client network.
TRUSTED_PROXY_CIDRS=
OFFICE_TIME_ZONE=Asia/Kolkata

# Required application secrets
JWT_SECRET=CHANGE_ME
PII_ENCRYPTION_KEY=CHANGE_ME
QR_PASS_SIGNING_SECRET=CHANGE_ME
MFA_REQUIRED_ROLES=ROLE_SYSTEM_ADMIN,ROLE_CEO,ROLE_HR_ADMIN,ROLE_MANAGER,ROLE_TEAM_LEAD
MFA_STEP_UP_SECONDS=300

# Broad office NAT budget; persisted account lockout remains independent.
AUTH_RATE_WINDOW_SECONDS=60
LOGIN_RATE_REQUESTS=600
REFRESH_RATE_REQUESTS=1200
LOGOUT_RATE_REQUESTS=600
UPLOADS_PER_MINUTE=20
EXPORT_JOBS_PER_MINUTE=5
EXPORTS_PER_MINUTE=30
SEARCHES_PER_MINUTE=120
STREAM_CONNECTS_PER_MINUTE=12
REALTIME_MAX_STREAMS_PER_ACCOUNT=3
REALTIME_STREAM_LEASE_SECONDS=90

# System Admin bootstrap (enable only for the first controlled startup)
SYSTEM_ADMIN_EMAIL=system.admin@brainserve.in
SYSTEM_ADMIN_DEFAULT_PASSWORD=
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=false

# CEO bootstrap (enable only for the first controlled startup)
CEO_BOOTSTRAP_ENABLED=false
CEO_BOOTSTRAP_NAME=BrainServe CEO
CEO_BOOTSTRAP_EMAIL=ceo@brainserve.in
CEO_BOOTSTRAP_PASSWORD=

# Identity and retention
COMPANY_EMAIL_DOMAIN=brainserve.in
SUPPORT_EMAIL=support@brainserve.in
ACCOUNT_ARCHIVE_RETENTION_YEARS=7
EXPIRED_SESSION_RETENTION_DAYS=30
SESSION_RETENTION_CRON=0 25 3 * * *
ACCOUNT_ARCHIVE_OTP_MINUTES=10
ACCOUNT_ARCHIVE_OTP_RESEND_SECONDS=60
ACCOUNT_ARCHIVE_OTP_MAX_ATTEMPTS=5
ADMIN_PASSWORD_VERIFICATION_LOCK_MINUTES=15
ACCOUNT_CLOSURE_CRON=0 5 0 * * *

# Reporting/archive encryption
ARCHIVE_ENCRYPTION_KEYS=v1=CHANGE_ME
ARCHIVE_ENCRYPTION_ACTIVE_KEY_VERSION=v1
DASHBOARD_CACHE_SECONDS=180
DASHBOARD_FRESH_SECONDS=120
REPORT_EXPORT_RETENTION_DAYS=7
REPORT_EXPORT_MAX_ROWS=1000000
PARTITION_ARCHIVE_ENABLED=true
PARTITION_CLEANUP_ENABLED=true
BACKUP_LIFECYCLE_RETENTION_DAYS=35

# Local MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Non-sensitive support metadata; only enum, semantic version and full Git SHA accepted.
SUPPORT_ENVIRONMENT=DEVELOPMENT
SUPPORT_RELEASE_VERSION=1.0.0
SUPPORT_BUILD_REVISION=UNKNOWN

# Google Calendar is disabled until all three values are configured together.
# Register the exact HTTPS callback in the Google OAuth web application.
# Keep the client secret in backend deployment secrets, never frontend variables.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_REVOCATION_POLL_MS=30000
# HTTPS application origin only; blank disables Slack. Bot tokens are entered by owners in Integrations.
SLACK_APP_BASE_URL=
SLACK_REVOCATION_POLL_MS=30000
