{$STAGING_DOMAIN} {
    # Access logging is intentionally disabled: OAuth callback queries carry codes.
    # Any deployment-level logging must redact queries, Cookie and Authorization.
    tls {$STAGING_TLS}
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        -Server
    }
    @api path /api/*
    handle @api {
        reverse_proxy backend:8080
    }
    handle /actuator/* {
        respond "Not found" 404
    }
    handle {
        reverse_proxy frontend:3000
    }
}
